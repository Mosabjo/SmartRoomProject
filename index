                    <div class="relative bg-slate-950 rounded-xl p-4 font-mono text-[11px] text-slate-400 border border-slate-900 max-h-80 overflow-y-auto custom-scrollbar shadow-inner">
<pre class="leading-relaxed"><code class="text-slate-300">#include &lt;WiFi.h&gt;
#include &lt;HTTPClient.h&gt;
#include &lt;ESP32Servo.h&gt;
#include "esp_camera.h"

const char* ssid = "YOUR_WIFI_SSID";
const char* password = "YOUR_WIFI_PASSWORD";
const char* apiEndpoint = "https://api.pushgateway.com/alert";

const int PIR_PIN = 14;   
const int LED_PIN = 26;   
const int BELL_PIN = 12;  
const int SERVO_PIN = 33; 

Servo doorLockServo;
int visitorCount = 0;     
bool lastMotionState = LOW; 
WiFiServer server(80);

void initCamera() {
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;
  config.pin_d0 = 5; config.pin_d1 = 18;
  config.pin_d2 = 19; config.pin_d3 = 21;
  config.pin_d4 = 36; config.pin_d5 = 39;
  config.pin_d6 = 34; config.pin_d7 = 35;
  config.pin_xclk = 0; config.pin_pclk = 22;
  config.pin_vsync = 25; config.pin_href = 23;
  config.pin_sscb_sda = 26; config.pin_sscb_scl = 27;
  config.pin_pwdn = 32; config.pin_reset = -1;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;
  config.frame_size = FRAMESIZE_QVGA;
  config.jpeg_quality = 12;
  esp_camera_init(&config);
}

void setup() {
  Serial.begin(115200);   
  pinMode(PIR_PIN, INPUT);  
  pinMode(LED_PIN, OUTPUT); 
  pinMode(BELL_PIN, INPUT_PULLUP); 

  doorLockServo.attach(SERVO_PIN); 
  doorLockServo.write(0); // 0 deg = Locked Default

  initCamera(); // Boot OV2640 Module

  WiFi.begin(ssid, password); 
  while (WiFi.status() != WL_CONNECTED) delay(500); 
  server.begin(); 
}

void triggerPushNotification(String action) {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    http.begin(apiEndpoint + "?event=" + action);
    http.GET();
    http.end();
  }
}

void checkIncomingCommands() {
  WiFiClient client = server.available();
  if (!client) return;
  String req = client.readStringUntil('\r');
  if (req.indexOf("/UNLOCK") != -1) doorLockServo.write(90);
  else if (req.indexOf("/LOCK") != -1) doorLockServo.write(0);
  client.flush();
}

void loop() {
  checkIncomingCommands();

  int motion = digitalRead(PIR_PIN); 
  if (motion == HIGH && lastMotionState == LOW) { 
    digitalWrite(LED_PIN, HIGH); 
    visitorCount++;             
    triggerPushNotification("Motion_Detected_" + String(visitorCount));
