            createCanvasTextLabel3D("ROOM LED", 2.4, 0.9, 0, "#fecdd3");

            const btnGroup = new THREE.Group();
            btnGroup.position.set(2.4, 0, 1.8);
            const caseGeo = new THREE.BoxGeometry(0.8, 0.3, 0.8);
            const caseMat = new THREE.MeshStandardMaterial({ color: 0x222222, roughness: 0.6 });
            const btnCase = new THREE.Mesh(caseGeo, caseMat); btnCase.position.y = 0.15; btnGroup.add(btnCase);
            const plungerGeo = new THREE.CylinderGeometry(0.24, 0.24, 0.15, 16);
            const plungerMat = new THREE.MeshStandardMaterial({ color: 0x3b82f6, roughness: 0.4 }); 
            const plunger = new THREE.Mesh(plungerGeo, plungerMat); plunger.position.y = 0.32; btnGroup.add(plunger);
            cScene.add(btnGroup);
            createCanvasTextLabel3D("DOORBELL", 2.4, 0.7, 1.8, "#fef3c7");

            const srvGroup = new THREE.Group();
            srvGroup.position.set(-2.2, 0, -2.2);
            const bodyGeo = new THREE.BoxGeometry(0.7, 1.1, 1.4);
            const bodyMat = new THREE.MeshStandardMaterial({ color: 0x0284c7, transparent: true, opacity: 0.9, roughness: 0.3 }); 
            const srvBody = new THREE.Mesh(bodyGeo, bodyMat); srvBody.position.y = 0.55; srvGroup.add(srvBody);
            const mountFlangeGeo = new THREE.BoxGeometry(0.7, 0.08, 2.2);
            const srvFlange = new THREE.Mesh(mountFlangeGeo, bodyMat); srvFlange.position.set(0, 0.85, 0); srvGroup.add(srvFlange);
            const gearTowerGeo = new THREE.CylinderGeometry(0.24, 0.24, 0.3, 16);
            const srvTower = new THREE.Mesh(gearTowerGeo, bodyMat); srvTower.position.set(0, 1.25, -0.3); srvTower.rotation.x = Math.PI/2; srvGroup.add(srvTower);
            const hornGeo = new THREE.BoxGeometry(0.16, 0.08, 1.6);
            const hornMat = new THREE.MeshStandardMaterial({ color: 0xeeeeee, roughness: 0.6 });
            const srvHorn = new THREE.Mesh(hornGeo, hornMat); srvHorn.position.set(0, 1.42, -0.3); srvHorn.rotation.y = Math.PI/3; srvGroup.add(srvHorn);
            cScene.add(srvGroup);
            createCanvasTextLabel3D("SERVO LOCK", -2.2, 1.7, -2.2, "#bfdbfe");

            // Wires
            drawRealisticWire([-2.0, 0.1, 0.1,  -0.5, 0.7, -0.8,  2.2, 0.1, -1.4], 0xeab308); // PIR
            drawRealisticWire([-1.8, 0.1, 0.5,  0.0, 0.9, 0.3,  2.4, 0.2, 0.0], 0xa855f7);    // LED
            drawRealisticWire([-2.0, 0.1, -0.1,  0.2, 0.8, 0.9,  2.4, 0.1, 1.6], 0x2563eb);   // Button
            drawRealisticWire([-2.1, 0.1, -0.3,  -2.5, 0.6, -1.0,  -2.2, 0.6, -1.6], 0xf97316);  // Servo
            drawRealisticWire([-1.4, 0.1, 0.9,  0.5, 0.2, -0.4,  2.6, 0.1, -1.4], 0x475569);  // GND Rail 1
            drawRealisticWire([-1.4, 0.1, 0.9,  0.8, 0.2, 0.8,  2.6, 0.1, 1.6], 0x475569);   // GND Rail 2

            // Cam Wires (I2C/SPI representations)
            drawRealisticWire([-1.4, 0.1, -1.0,  -0.8, 0.4, -1.8,  -0.3, 0.1, -2.1], 0xf43f5e); // Red
            drawRealisticWire([-1.6, 0.1, -0.8,  -1.0, 0.3, -2.0,  -0.5, 0.1, -2.1], 0x0ea5e9); // Cyan
        }

        function createCanvasTextLabel3D(textString, posX, posY, posZ, labelHexColor) {
            const canvasElement = document.createElement('canvas');
            canvasElement.width = 256;
            canvasElement.height = 64;
            const drawContext = canvasElement.getContext('2d');
            
            drawContext.fillStyle = "rgba(0,0,0,0)";
            drawContext.fillRect(0, 0, 256, 64);
            
            drawContext.fillStyle = labelHexColor;
            drawContext.font = "bold 24px 'JetBrains Mono', monospace";
            drawContext.textAlign = "center";
            drawContext.textBaseline = "middle";
            drawContext.fillText(textString, 128, 32);

            const textTexture = new THREE.CanvasTexture(canvasElement);
            const planeGeometry = new THREE.PlaneGeometry(1.6, 0.4);
            const planeMaterial = new THREE.MeshBasicMaterial({ map: textTexture, transparent: true, side: THREE.DoubleSide });
            
            const labelMeshNode = new THREE.Mesh(planeGeometry, planeMaterial);
            labelMeshNode.position.set(posX, posY, posZ);
            labelMeshNode.rotation.x = -Math.PI / 6;
            cScene.add(labelMeshNode);
        }

        function drawRealisticWire(coords, hexColor) {
            const points = [];
            for (let i = 0; i < coords.length; i += 3) {
                points.push(new THREE.Vector3(coords[i], coords[i+1], coords[i+2]));
            }
            const path = new THREE.CatmullRomCurve3(points);
            const tube = new THREE.TubeGeometry(path, 32, 0.05, 10, false); 
            const mat = new THREE.MeshStandardMaterial({ color: hexColor, roughness: 0.2, metalness: 0.1 });
            const mesh = new THREE.Mesh(tube, mat);
            cScene.add(mesh);
        }

        function animateCircuit() {
            requestAnimationFrame(animateCircuit);
            cControls.update();
            cRenderer.render(cScene, cCamera);
        }

        window.addEventListener('resize', () => {
            const container1 = document.getElementById('canvas-container');
            if(container1 && camera && renderer && container1.clientWidth > 0) {
                camera.aspect = container1.clientWidth / container1.clientHeight;
                camera.updateProjectionMatrix(); 
                renderer.setSize(container1.clientWidth, container1.clientHeight);
            }
            const container2 = document.getElementById('circuit-canvas-container');
            if(container2 && cCamera && cRenderer && container2.clientWidth > 0) {
                cCamera.aspect = container2.clientWidth / container2.clientHeight;
                cCamera.updateProjectionMatrix(); 
                cRenderer.setSize(container2.clientWidth, container2.clientHeight);
            }
        });
    </script>
</body>
</html>
